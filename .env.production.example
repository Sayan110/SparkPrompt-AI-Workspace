# SparkPrompt PRODUCTION environment — template (Phase 4D).
#
# Copy to `.env.production` (gitignored) or, preferably, inject these through
# your secret infrastructure (Docker secrets, systemd EnvironmentFile, CI/CD
# secrets, a vault...). NEVER put real values in this file. NEVER commit
# `.env.production`.
#
# Production FAILS STARTUP (fail closed) when required values are missing or
# still at development defaults. Pre-deploy validation:
#     python -m app.core.config_check --require production
# Error messages name the variable and the fix — never a value.

# ---------------------------------------------------------------------------
# Required in production
# ---------------------------------------------------------------------------

# Stable session signing key (>= 32 random characters). REQUIRED: an
# ephemeral key would invalidate every session on every restart.
# The placeholder below is intentionally SHORTER than 32 characters and is
# REJECTED on purpose — copy-pasting this file fails validation until you
# generate a real one:  openssl rand -hex 32
SESSION_SECRET=<openssl-rand-hex-32-here>

# Production database URL. Must not use the development default or the
# development password. Uncomment and set (compose refuses to start without it).
# DATABASE_URL=postgresql+psycopg://<user>:<password>@<host>:5432/<database>

# Trusted browser origins for credentialed CORS — explicit, never "*".
CORS_ORIGINS=https://app.example.com

# Public origin of the frontend, used at web-image BUILD time so the browser
# calls /api/* same-origin through the reverse proxy (session cookie stays
# SameSite=Lax).
NEXT_PUBLIC_API_URL=https://app.example.com

# ---------------------------------------------------------------------------
# Bundled PostgreSQL (only with `docker compose --profile with-db ...`)
# All three are required by docker-compose.prod.yml when the profile is used.
# ---------------------------------------------------------------------------
# POSTGRES_USER=<production-secret>
# POSTGRES_PASSWORD=<production-secret>
# POSTGRES_DB=sparkprompt

# ---------------------------------------------------------------------------
# Optional / defaults that docker-compose.prod.yml already pins safely
# ---------------------------------------------------------------------------
# SESSION_COOKIE_SECURE=true        # forced by docker-compose.prod.yml
# WEB_CONCURRENCY=1                 # keep 1: auth rate-limit + revocation
#                                   # state is process-local (documented 4D)
# AI_DEFAULT_PROVIDER=gemini
# GEMINI_API_KEY=                   # server-side only; never NEXT_PUBLIC_*
# NVIDIA_API_KEY=                   # server-side only; never NEXT_PUBLIC_*
