# Optional: absolute API origin. When unset, apiUrl() derives it from the page
# hostname (protocol + <hostname>:8000) so the session cookie stays same-site:
# localhost:3000 -> localhost:8000, 127.0.0.1:3000 -> 127.0.0.1:8000.
# Only set this when the API lives on a different origin (e.g. behind a proxy),
# and keep it same-site with the page origin or SameSite=Lax cookies will not
# be sent and login will not stick.
# NEXT_PUBLIC_API_URL=http://localhost:8000
