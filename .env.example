# Copy this file to .env and adjust as needed.
# Never commit real secrets. All values here are placeholders.
#
# DEVELOPMENT defaults (Phase 4D): everything below is for local work only.
# Production configuration is a separate, fail-closed surface — see
# .env.production.example and validate it with:
#     python -m app.core.config_check --require production

# PostgreSQL (docker compose in infra/)
POSTGRES_USER=sparkprompt
POSTGRES_PASSWORD=sparkprompt
POSTGRES_DB=sparkprompt
POSTGRES_PORT=5432

# FastAPI
DATABASE_URL=postgresql+psycopg://sparkprompt:sparkprompt@127.0.0.1:5432/sparkprompt
API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- AI Gateway (server-side only; NEVER shipped to the browser) ---

# Default provider used when a request does not choose one.
AI_DEFAULT_PROVIDER=gemini

# How long provider calls may take before timing out (seconds).
AI_TIMEOUT_SECONDS=60

# Google Gemini: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=
# Optional default model for requests that do not specify one.
# GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# NVIDIA NIM: https://build.nvidia.com
# NVIDIA_API_KEY=
# Optional alternate NVIDIA API base + default model.
# NVIDIA_BASE_URL=https://integration.api.nvidia.com
# NVIDIA_DEFAULT_MODEL=nvidia/llama-3.3-nemotron-70b-instruct

# Ollama (local): not strictly required - provider reports unavailable when unreachable.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_DEFAULT_MODEL=

# Session / authentication (Phase 4A)
# Signing key for session tokens. Leave unset for an ephemeral per-process key
# (sessions then die with the backend - fine for LOCAL DEV only). Production
# REQUIRES an explicit stable SESSION_SECRET (>= 32 chars) and refuses to
# start without it (Phase 4D fail-closed rule). NEVER commit a real value.
# SESSION_SECRET=
# Session lifetime in seconds (default: 12 hours).
# SESSION_TTL_SECONDS=43200
# Cookie Secure flag: false for local http:// development; production
# requires true (docker-compose.prod.yml forces it; config_check enforces it).
# SESSION_COOKIE_SECURE=false

# Next.js
# Optional override for the API origin. When unset, the frontend derives it from
# the page hostname (http://<hostname>:8000) so the session cookie stays
# same-site. If you set it, its hostname must match the page origin's hostname,
# otherwise SameSite=Lax cookies are never sent and login cannot stick.
NEXT_PUBLIC_API_URL=http://localhost:8000